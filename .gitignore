*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example
!frontend/.env.example
!frontend/.env.production.example
*.pem
*.key
*.crt
*.p12
*.pfx
*token*
*secret*
credentials.json

# Node and frontend output
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend runtime data
backend/data/*.db
backend/data/*.db-*
backend/data/*.sqlite
backend/data/*.sqlite3

