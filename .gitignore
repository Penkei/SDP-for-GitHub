temp_repos/
sdp_github_temp_repos/
ml_workspace/temp_repos/
ml_workspace/**/temp_repos/

# Notebook cache
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Logs
*.log
logs/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build and deployment cache
.cache/
.docker/